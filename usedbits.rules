and_used_redundant: And(x, C) @used_bits(Cused)
    check Cused & ~C == 0
    => x

and_used_mask: And(x, C) @used_bits(Cused)
    Cnew = C & Cused
    check Cnew != C
    => And(x, Cnew)

or_used_redundant: Or(x, C) @used_bits(Cused)
    check Cused & C == 0
    => x

resize_u_unused_upper: ResizeU(x: T): U @used_bits(Cused)
    where width(T) < width(U)
    Cmask = bits(bits(-1, T), U)
    check Cused & ~Cmask == 0
    => ResizeX(x): U

resize_s_unused_upper: ResizeS(x: T): U @used_bits(Cused)
    where width(T) < width(U)
    Cmask = bits(bits(-1, T), U)
    check Cused & ~Cmask == 0
    => ResizeX(x): U

xor_unused_constant: Xor(x, C) @used_bits(Cused)
    check Cused & C == 0
    => x

or_used_mask: Or(x, C) @used_bits(Cused)
    Cnew = C & Cused
    check Cnew != C
    => Or(x, Cnew)

add_unused_constant: Add(x, C) @used_bits(Cused)
    Clow = C & -C
    check Cused < Clow
    => x

xor_used_mask: Xor(x, C) @used_bits(Cused)
    Cnew = C & Cused
    check Cnew != C
    => Xor(x, Cnew)

select_used_constants: Select(c, C1, C2) @used_bits(Cused)
    Ctrue = C1 & Cused
    Cfalse = C2 & Cused
    check Ctrue != C1 or Cfalse != C2
    => Select(c, Ctrue, Cfalse)

shl_used_zero: Shl(x: T, C) @used_bits(Cused)
    check C < width(T)
    check Cused >> C == 0
    => 0

shr_u_used_zero: ShrU(x: T, C) @used_bits(Cused)
    check C < width(T)
    check Cused << C == 0
    => 0
