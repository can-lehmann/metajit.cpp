and_used_redundant: And(x, C) @used_bits(Cused)
    check Cused & ~C == 0
    => x

and_used_mask: And(x, C) @used_bits(Cused)
    Cnew = C & Cused
    check Cnew != C
    => And(x, Cnew)

or_used_redundant: Or(x, C) @used_bits(Cused)
    check Cused & C == 0
    => x

resize_u_unused_upper: ResizeU(x: T): U @used_bits(Cused)
    where width(T) < width(U)
    Cmask = bits(bits(-1, T), U)
    check Cused & ~Cmask == 0
    => ResizeX(x): U

resize_s_unused_upper: ResizeS(x: T): U @used_bits(Cused)
    where width(T) < width(U)
    Cmask = bits(bits(-1, T), U)
    check Cused & ~Cmask == 0
    => ResizeX(x): U
