and_self: And(x, x)
    => x

and_reassoc_constants: And(And(x, C1), C2)
    C = C1 & C2
    => And(x, C)

and_redundant_operand: And(x, y)
    check known_zeros(x) | known_ones(y) == -1
    => x

and_shifted_known_mask: And(ResizeU(ShrU(x: S, s)): T, ResizeU(ShrU(C: S, s)): T)
    check known_zeros(x) | C == -1
    => ResizeU(ShrU(x, s)): T

or_redundant_operand: Or(x, y)
    check known_ones(x) | known_zeros(y) == -1
    => x

and_or_disjoint: And(Or(x, y), z)
    check known_zeros(y) | known_zeros(z) == -1
    => And(x, z)

add_disjoint: Add(x, y)
    check known_zeros(x) | known_zeros(y) == -1
    => Or(x, y)

sub_or_disjoint: Sub(Or(x, y), y)
    check known_zeros(x) | known_zeros(y) == -1
    => x

xor_clear_known_ones: Xor(x, C)
    check known_ones(x) & C == C
    Cmask = ~C
    => And(x, Cmask)

sub_xor_disjoint: Sub(Xor(x, y), y)
    check known_zeros(x) | known_zeros(y) == -1
    => x

eq_or_disjoint_zero: Eq(Or(x, y), 0)
    check known_zeros(x) | known_zeros(y) == -1
    => Eq(x, y)

eq_boolean_one: Eq(x, 1)
    check known_zeros(x) | 1 == -1
    => ResizeX(x): Bool

shr_u_shl_known_no_loss: ShrU(Shl(x: T, C), C)
    check C < width(T)
    Cmask = -1 >> C
    check known_zeros(x) | Cmask == -1
    => x

shr_u_shl_known_no_loss_right: ShrU(Shl(x: T, C1), C2)
    check C1 < C2 and C2 < width(T)
    Cmask = -1 >> C1
    check known_zeros(x) | Cmask == -1
    Cshift = C2 - C1
    => ShrU(x, Cshift)

shr_s_shl_known_no_loss: ShrS(Shl(x: T, C), C)
    check C < width(T)
    Ctop = -1 << (width(T) - 1 - C)
    check known_zeros(x) & Ctop == Ctop or known_ones(x) & Ctop == Ctop
    => x

shr_s_nonnegative: ShrS(x: T, y)
    Csign = 1 << (width(T) - 1)
    check known_zeros(x) & Csign != 0
    => ShrU(x, y)

and_xor_disjoint: And(Xor(x, y), z)
    check known_zeros(y) | known_zeros(z) == -1
    => And(x, z)

select_known_true: Select(c, x, y)
    check known_ones(c) == 1
    => x

select_known_false: Select(c, x, y)
    check known_zeros(c) == 1
    => y

resize_u_resize_x_known_zero_roundtrip: ResizeU(ResizeX(x: T): U): T
    where width(T) > width(U)
    Cmask = bits(bits(-1, U), T)
    check known_zeros(x) | Cmask == -1
    => x

resize_u_resize_u_known_zero_roundtrip: ResizeU(ResizeU(x: T): U): T
    where width(T) > width(U)
    Cmask = bits(bits(-1, U), T)
    check known_zeros(x) | Cmask == -1
    => x

resize_u_resize_s_known_zero_roundtrip: ResizeU(ResizeS(x: T): U): T
    where width(T) > width(U)
    Cmask = bits(bits(-1, U), T)
    check known_zeros(x) | Cmask == -1
    => x

shr_u_or_known_zero: ShrU(Or(x: T, y), C)
    check C < width(T)
    Cmask = -1 << C
    check known_zeros(x) & Cmask == Cmask
    => ShrU(y, C)

shl_or_constant_single_use: Shl(Or(x: T, C1) @single_use, C2)
    check C2 < width(T)
    C = C1 << C2
    => Or(Shl(x, C2), C)

or_collect_constants: Or(Or(Or(x, C1), y) @single_use, C2)
    C = C1 | C2
    => Or(Or(x, y), C)

and_collect_constants: And(And(And(x, C1), y) @single_use, C2)
    C = C1 & C2
    => And(And(x, y), C)

xor_collect_constants: Xor(Xor(Xor(x, C1), y) @single_use, C2)
    C = C1 ^ C2
    => Xor(Xor(x, y), C)

eq_masked_shr_u_zero: Eq(And(ShrU(x: T, C), Cmask) @single_use, 0)
    check C < width(T)
    Cnew = Cmask << C
    => Eq(And(x, Cnew), 0)

eq_shr_u_zero: Eq(ShrU(x: T, C) @single_use, 0)
    check C < width(T)
    Cmask = -1 << C
    => Eq(And(x, Cmask), 0)

eq_masked_shl_zero: Eq(And(Shl(x: T, C), Cmask) @single_use, 0)
    check C < width(T)
    Cnew = Cmask >> C
    => Eq(And(x, Cnew), 0)

select_add_same_condition: Select(c, Add(Select(c, x, C1), C2) @single_use, C3)
    => Select(c, Add(x, C2), C3)

select_factor_complementary_conditions: Select(And(a, b), x, Select(And(Xor(a, 1), b), y, z) @single_use)
    => Select(b, Select(a, x, y), z)

select_factor_false_bit: Select(And(c, ResizeU(Select(c, v: S, C)): Bool), x, Select(ResizeU(Select(c, v: S, C)): Bool, z, y) @single_use)
    check C & 1 == 1
    => Select(c, Select(ResizeU(Select(c, v, C)): Bool, x, y), z)

select_factor_false_shifted_bit: Select(And(c, ResizeU(ShrU(Select(c, v: S, C1), C2)): Bool), x, Select(ResizeU(ShrU(Select(c, v: S, C1), C2)): Bool, z, y) @single_use)
    check C2 < width(S)
    check (C1 >> C2) & 1 == 1
    => Select(c, Select(ResizeU(ShrU(Select(c, v, C1), C2)): Bool, x, y), z)

eq_truncated_add_constant: Eq(ResizeU(Add(x: S, C1) @single_use): T @single_use, C2)
    where width(T) < width(S)
    C = C2 - bits(C1, T)
    => Eq(ResizeU(x): T, C)

eq_extended_constant: Eq(ResizeU(x: S): T @single_use, C)
    where width(T) > width(S)
    Cnarrow = bits(C, S)
    check bits(Cnarrow, T) == C
    => Eq(x, Cnarrow)

not_eq_zero_single_use: Xor(Eq(x, 0) @single_use, 1)
    => LtU(0, x)

eq_select_impossible: Eq(Select(c, x, y), C)
    check (known_ones(x) & ~C) | (known_zeros(x) & C) != 0
    check (known_ones(y) & ~C) | (known_zeros(y) & C) != 0
    => 0: Bool

lt_u_select_known_range: LtU(Select(c, x, C1), C2)
    check ~known_zeros(x) < C2 and C1 >= C2
    => c

xor_or_operand_single_use: Xor(Or(x, y) @single_use, x)
    => And(y, Xor(x, -1))

and_xor_operand_single_use: And(Xor(x, y) @single_use, y)
    => And(y, Xor(x, -1))

xor_nonzero_single_use: Xor(LtU(0, x) @single_use, 1)
    => Eq(x, 0)

resize_u_or_known_zero: ResizeU(Or(x: S, y)): T
    where width(T) < width(S)
    Cmask = bits(bits(-1, T), S)
    check known_zeros(y) & Cmask == Cmask
    => ResizeU(x): T

eq_lossless_truncate: Eq(ResizeU(x: S): T, C)
    where width(T) < width(S)
    Cmask = bits(bits(-1, T), S)
    check known_zeros(x) | Cmask == -1
    Cwide = bits(C, S)
    => Eq(x, Cwide)

eq_nested_select_true_constants: Eq(Select(c, Select(d, C1, C2), C3) @single_use, C4)
    Ctrue = C1 == C4
    Cfalse = C2 == C4
    Couter = C3 == C4
    => Select(c, Select(d, Ctrue, Cfalse), Couter)

eq_nested_select_false_constants: Eq(Select(c, C1, Select(d, C2, C3)) @single_use, C4)
    Couter = C1 == C4
    Ctrue = C2 == C4
    Cfalse = C3 == C4
    => Select(c, Couter, Select(d, Ctrue, Cfalse))

eq_masked_remove_known_bits: Eq(And(x, Cmask) @single_use, Cvalue)
    check Cvalue & ~Cmask == 0
    check Cvalue & known_zeros(x) == 0
    check (Cmask & known_ones(x)) & ~Cvalue == 0
    Cnew = Cmask & ~(known_zeros(x) | known_ones(x))
    Cexpect = Cvalue & Cnew
    check Cnew != Cmask
    => Eq(And(x, Cnew), Cexpect)

and_or_keep_fitting_operand: And(Or(x, y) @single_use, C)
    check known_zeros(x) | known_ones(x) != -1
    check known_zeros(x) | C == -1
    => Or(x, And(y, C))
