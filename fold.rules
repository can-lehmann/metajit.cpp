add_zero: Add(x, 0)
    => x

add_constants: Add(C1, C2)
    C = C1 + C2
    => C

add_select_constant: Add(Select(c, C1, C2), C3)
    Ctrue = C1 + C3
    Cfalse = C2 + C3
    => Select(c, Ctrue, Cfalse)

add_selects: Add(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 + C3
    Cfalse = C2 + C4
    => Select(c, Ctrue, Cfalse)

add_reassoc_constants: Add(Add(x, C1), C2)
    C = C1 + C2
    => Add(x, C)

add_not_plus_one: Add(Add(x, Xor(y, -1)), 1)
    => Sub(x, y)

sub_self: Sub(x, x)
    => 0

sub_zero: Sub(x, 0)
    => x

sub_constant: Sub(x, C)
    Cneg = -C
    => Add(x, Cneg)

sub_constants: Sub(C1, C2)
    C = C1 - C2
    => C

sub_select_constant: Sub(Select(c, C1, C2), C3)
    Ctrue = C1 - C3
    Cfalse = C2 - C3
    => Select(c, Ctrue, Cfalse)

sub_selects: Sub(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 - C3
    Cfalse = C2 - C4
    => Select(c, Ctrue, Cfalse)

sub_constant_select: Sub(C1, Select(c, C2, C3))
    Ctrue = C1 - C2
    Cfalse = C1 - C3
    => Select(c, Ctrue, Cfalse)

mul_zero: Mul(x, 0)
    => 0

mul_one: Mul(x, 1)
    => x

mul_constants: Mul(C1, C2)
    C = C1 * C2
    => C

mul_select_constant: Mul(Select(c, C1, C2), C3)
    Ctrue = C1 * C3
    Cfalse = C2 * C3
    => Select(c, Ctrue, Cfalse)

mul_selects: Mul(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 * C3
    Cfalse = C2 * C4
    => Select(c, Ctrue, Cfalse)

mul_power_of_two: Mul(x, C)
    check C != 0 and C & (C - 1) == 0
    Cshift = ctz(C)
    => Shl(x, Cshift)

mul_shift_one: Mul(x, Shl(1, y))
    => Shl(x, y)

mul_high_u_zero: MulHighU(x, 0)
    => 0

mul_high_u_one: MulHighU(x, 1)
    => 0

mul_high_u_constants: MulHighU(C1, C2)
    C = mul_high_u(C1, C2)
    => C

mul_high_u_select_constant: MulHighU(Select(c, C1, C2), C3)
    Ctrue = mul_high_u(C1, C3)
    Cfalse = mul_high_u(C2, C3)
    => Select(c, Ctrue, Cfalse)

mul_high_u_selects: MulHighU(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = mul_high_u(C1, C3)
    Cfalse = mul_high_u(C2, C4)
    => Select(c, Ctrue, Cfalse)

mul_high_u_power_of_two: MulHighU(x: T, C)
    check C > 1 and C & (C - 1) == 0
    Cshift = width(T) - ctz(C)
    => ShrU(x, Cshift)

bit_reverse_constant: BitReverse(C)
    Creversed = bit_reverse(C)
    => Creversed

bit_reverse_twice: BitReverse(BitReverse(x))
    => x

bit_reverse_select: BitReverse(Select(c, C1, C2))
    Ctrue = bit_reverse(C1)
    Cfalse = bit_reverse(C2)
    => Select(c, Ctrue, Cfalse)

bit_reverse_shl_reverse: BitReverse(Shl(BitReverse(x), y))
    => ShrU(x, y)

bit_reverse_shr_u_reverse: BitReverse(ShrU(BitReverse(x), y))
    => Shl(x, y)

mod_u_power_of_two: ModU(x, C)
    SORRY_Z3_SMALL_WIDTHS
    check C != 0 and C & (C - 1) == 0
    Cmask = C - 1
    => And(x, Cmask)

and_self: And(x, x)
    => x

and_zero: And(x, 0)
    => 0

and_all_ones: And(x, -1)
    => x

and_constants: And(C1, C2)
    C = C1 & C2
    => C

and_select_constant: And(Select(c, C1, C2), C3)
    Ctrue = C1 & C3
    Cfalse = C2 & C3
    => Select(c, Ctrue, Cfalse)

and_selects: And(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 & C3
    Cfalse = C2 & C4
    => Select(c, Ctrue, Cfalse)

and_reassoc_constants: And(And(x, C1), C2)
    C = C1 & C2
    => And(x, C)

and_reassoc_redundant_constant: And(And(x, C1), C2)
    check C1 & C2 == C1
    => And(x, C1) # reuse inner op

and_or_disjoint_masks: And(Or(x, And(y, C1)), C2)
    check C1 & C2 == 0
    => And(x, C2)

and_complement: And(Xor(x, -1), x)
    => 0

and_xor_constant: And(Xor(x, C), x)
    Cmask = ~C
    => And(x, Cmask)

and_xor_subset_zero: And(Xor(And(x, y), x), And(x, y))
    => 0

and_complement_or: And(Xor(x, -1), Or(x, y))
    => And(Xor(x, -1), y)

and_or_absorb: And(Or(x, y), x)
    => x

and_or_and_absorb: And(Or(x, y), And(x, z))
    => And(x, z)

and_or_common_operand: And(Or(x, y), Or(x, z))
    => Or(x, And(y, z))

and_absorb: And(And(x, y), x)
    => And(x, y)

and_common_operand: And(And(x, y), And(x, z))
    => And(And(x, y), z)

# and_deep_absorb: And(And(And(x, y), z), x)
#     => And(And(x, y), z)

# and_deep_or_absorb: And(Or(Or(x, y), z), x)
#     => x

and_select_false_bit_complement: And(c, Xor(ResizeU(Select(c, x: T, C)): Bool, 1))
    check C & 1 == 1
    => Xor(ResizeU(Select(c, x, C)): Bool, 1)

and_select_false_shifted_bit_complement: And(c, Xor(ResizeU(ShrU(Select(c, x: T, C1), C2)): Bool, 1))
    check C2 < width(T)
    check (C1 >> C2) & 1 == 1
    => Xor(ResizeU(ShrU(Select(c, x, C1), C2)): Bool, 1)

and_select_lt_u: And(c, LtU(Select(c, x, C1), C2))
    check C1 >= C2
    => LtU(Select(c, x, C1), C2)

and_complement_or_absorb: And(Xor(Or(x, y), -1), Xor(y, -1))
    => Xor(Or(x, y), -1)

and_select_complement: And(c, Xor(Select(c, x, 0: Bool), 1))
    => Xor(c, Select(c, x, 0: Bool))

and_not_or_complement_absorb: And(Xor(Or(y, Xor(x, -1)), -1), x)
    => Xor(Or(y, Xor(x, -1)), -1)

and_select_zero_absorb: And(c, Select(c, x, 0: Bool))
    => Select(c, x, 0: Bool)

and_not_select_zero_absorb: And(Xor(c, 1), Select(c, 0: Bool, x))
    => Select(c, 0: Bool, x)

or_self: Or(x, x)
    => x

or_zero: Or(x, 0)
    => x

or_all_ones: Or(x, -1)
    => -1

or_constants: Or(C1, C2)
    C = C1 | C2
    => C

or_select_constant: Or(Select(c, C1, C2), C3)
    Ctrue = C1 | C3
    Cfalse = C2 | C3
    => Select(c, Ctrue, Cfalse)

or_selects: Or(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 | C3
    Cfalse = C2 | C4
    => Select(c, Ctrue, Cfalse)

or_select_value: Or(Select(c, x, C1), Select(c, 0, C2))
    C = C1 | C2
    => Select(c, x, C)

or_select_redundant_mask: Or(Select(c, x, C1), Select(c, 0, C2))
    check C1 | C2 == C1
    => Select(c, x, C1)

or_resized_select_redundant_mask: Or(ResizeU(Select(c, x: S, C1)): T, Select(c, 0, C2))
    check bits(C1, T) | C2 == bits(C1, T)
    => ResizeU(Select(c, x, C1)): T

or_reassoc_constants: Or(Or(x, C1), C2)
    C = C1 | C2
    => Or(x, C)

or_reassoc_redundant_constant: Or(Or(x, C1), C2)
    check C1 | C2 == C1
    => Or(x, C1) # reuse inner op

or_and_common_operand: Or(And(x, y), And(x, z))
    => And(x, Or(y, z))

or_and_absorb: Or(And(x, y), x)
    => x

or_and_or_absorb: Or(And(x, y), Or(x, z))
    => Or(x, z)

or_and_complement: Or(And(x, y), Xor(x, -1))
    => Or(y, Xor(x, -1))

or_nested_complement: Or(Or(Xor(x, -1), y), x)
    => -1

or_nested_and_absorb: Or(Or(And(x, y), z), x)
    => Or(x, z)

or_absorb: Or(Or(x, y), x)
    => Or(x, y)

or_common_operand: Or(Or(x, y), Or(x, z))
    => Or(Or(x, y), z)

# or_deep_absorb: Or(Or(Or(x, y), z), x)
#     => Or(Or(x, y), z)

# or_deep_and_absorb: Or(And(And(x, y), z), x)
#     => x

or_xor_absorb: Or(Xor(x, y), x)
    => Or(x, y)

or_pair_xor_absorb: Or(Or(x, y), Xor(x, y))
    => Or(x, y)

or_nested_xor_complement: Or(Or(Xor(x, -1), Xor(x, y)), y)
    => -1

or_complement_or_absorb: Or(Xor(Or(x, y), -1), x)
    => Or(x, Xor(y, -1))

or_select_false_bit: Or(ResizeU(Select(c, x: T, C)): Bool, Xor(c, 1))
    check C & 1 == 1
    => ResizeU(Select(c, x, C)): Bool

or_select_false_shifted_bit: Or(ResizeU(ShrU(Select(c, x: T, C1), C2)): Bool, Xor(c, 1))
    check C2 < width(T)
    check (C1 >> C2) & 1 == 1
    => ResizeU(ShrU(Select(c, x, C1), C2)): Bool

or_select_one_absorb: Or(c, Select(c, 1: Bool, x))
    => Select(c, 1: Bool, x)

or_not_select_one_absorb: Or(Xor(c, 1), Select(c, x, 1: Bool))
    => Select(c, x, 1: Bool)

xor_self: Xor(x, x)
    => 0

xor_zero: Xor(x, 0)
    => x

xor_constants: Xor(C1, C2)
    C = C1 ^ C2
    => C

xor_select_constant: Xor(Select(c, C1, C2), C3)
    Ctrue = C1 ^ C3
    Cfalse = C2 ^ C3
    => Select(c, Ctrue, Cfalse)

xor_selects: Xor(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 ^ C3
    Cfalse = C2 ^ C4
    => Select(c, Ctrue, Cfalse)

xor_reassoc_constants: Xor(Xor(x, C1), C2)
    C = C1 ^ C2
    => Xor(x, C)

xor_cancel: Xor(Xor(x, y), y)
    => x

xor_common_operand: Xor(Xor(x, y), Xor(x, z))
    => Xor(y, z)

eq_self: Eq(x, x)
    => 1

eq_constants: Eq(C1, C2)
    C = C1 == C2
    => C

eq_select_constant: Eq(Select(c, C1, C2), C3)
    Ctrue = C1 == C3
    Cfalse = C2 == C3
    => Select(c, Ctrue, Cfalse)

eq_selects: Eq(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 == C3
    Cfalse = C2 == C4
    => Select(c, Ctrue, Cfalse)

eq_bool_one: Eq(x: Bool, 1)
    => x

eq_extended_bool_one: Eq(ResizeU(c: Bool), 1)
    => c

eq_bool_zero: Eq(x: Bool, 0)
    => Xor(x, 1)

eq_xor_zero: Eq(Xor(x, y), 0)
    => Eq(x, y)

eq_xor_constant: Eq(Xor(x, C1), C2)
    C = C1 ^ C2
    => Eq(x, C)

eq_sub_zero: Eq(Sub(x, y), 0)
    => Eq(x, y)

eq_masked_impossible: Eq(And(x, Cmask), C2)
    check C2 & ~Cmask != 0
    => 0: Bool

eq_masked_xor: Eq(And(Xor(x, C1), Cmask), C2)
    check C2 & ~Cmask == 0
    Cnew = C2 ^ (C1 & Cmask)
    => Eq(And(x, Cmask), Cnew)

eq_shifted_bool_bit: Eq(And(Shl(ResizeX(Shl(ResizeX(x: Bool): U, C1)): T, C2), Cmask), Cmask)
    where width(U) > 1 and width(T) > width(U)
    check C1 < width(U) and C2 < width(T)
    Csum = bits(C1, T) + C2
    check Csum < width(T)
    Cbit = 1 << Csum
    check Cmask == Cbit
    => x

eq_masked_shl: Eq(Shl(And(x: T, Cmask), Cshift), Cvalue)
    check Cshift < width(T)
    check Cmask & ~(-1 >> Cshift) == 0
    check (Cvalue >> Cshift) << Cshift == Cvalue
    Cnew = Cvalue >> Cshift
    => Eq(And(x, Cmask), Cnew)

eq_nested_select_unique_true: Eq(Select(c, Select(d, C1, C2), C3), C1)
    check C1 != C2 and C1 != C3
    => Select(c, d, 0: Bool)

eq_nested_select_unique_outer: Eq(Select(c, C1, Select(d, C2, C3)), C1)
    check C1 != C2 and C1 != C3
    => c

eq_nested_select_encoding_low_bit: Eq(Select(c, C1: S, Select(d, C2, C3)), Cvalue)
    check (C1 == Cvalue) == ((C1 & 1) == 1)
    check (C2 == Cvalue) == ((C2 & 1) == 1)
    check (C3 == Cvalue) == ((C3 & 1) == 1)
    => ResizeU(Select(c, C1, Select(d, C2, C3))): Bool

lt_u_self: LtU(x, x)
    => 0

lt_u_zero: LtU(x, 0)
    => 0

lt_u_constants: LtU(C1, C2)
    C = C1 < C2
    => C

lt_u_select_constant: LtU(Select(c, C1, C2), C3)
    Ctrue = C1 < C3
    Cfalse = C2 < C3
    => Select(c, Ctrue, Cfalse)

lt_u_selects: LtU(Select(c, C1, C2), Select(c, C3, C4))
    Ctrue = C1 < C3
    Cfalse = C2 < C4
    => Select(c, Ctrue, Cfalse)

lt_u_constant_select: LtU(C1, Select(c, C2, C3))
    Ctrue = C1 < C2
    Cfalse = C1 < C3
    => Select(c, Ctrue, Cfalse)

lt_u_independent_selects_or: LtU(Select(c, C1, C2), Select(d, C3, C4))
    check C1 < C3 and C1 < C4 and C2 < C3 and C2 >= C4
    => Or(c, d)

lt_u_independent_selects_and: LtU(Select(c, C1, C2), Select(d, C3, C4))
    check C1 < C3 and C1 >= C4 and C2 >= C3 and C2 >= C4
    => And(c, d)

lt_s_self: LtS(x, x)
    => 0

lt_s_nested_select_sign: LtS(Select(And(c, d), C1: T, Select(c, C2, C3)), 0)
    Csign = 1 << (width(T) - 1)
    check C1 & Csign != 0 and C2 & Csign != 0 and C3 & Csign == 0
    => c

select_true: Select(1, x, y)
    => x

select_false: Select(0, x, y)
    => y

select_same: Select(c, x, x)
    => x

select_equal_arms: Select(Eq(x, y), x, y)
    => y

select_eq_true_constant: Select(Eq(x, C), x, y)
    => Select(Eq(x, C), C, y)

select_equal_resize: Select(Eq(x: S, C1), C2: T, ResizeU(x): T)
    check bits(C1, T) == C2
    => ResizeU(x): T

select_bool_complement_arms: Select(c, c, Xor(c, 1))
    => 1

select_and_nested: Select(And(c, d), x, Select(c, x, y))
    => Select(c, x, y)

select_complement_condition: Select(Xor(c, 1), x, y)
    => Select(c, y, x)

select_bool_identity: Select(c, 1: Bool, 0)
    => c

select_bool_complement: Select(c, 0: Bool, 1)
    => Xor(c, 1)

select_bool_true_operand_constant: Select(c, c, C)
    => Or(c, C)

select_bool_false_operand_constant: Select(c, C, c)
    => And(c, C)

select_nested_true: Select(c, Select(c, x, y), z)
    => Select(c, x, z)

select_nested_false: Select(c, x, Select(c, y, z))
    => Select(c, x, z)

resize_u_identity: ResizeU(x: T): T
    => x

resize_u_add_discarded_constant: ResizeU(Add(x: S, C)): T
    where width(T) < width(S)
    check bits(C, T) == 0
    => ResizeU(x): T

resize_u_add_shift_above_width: ResizeU(Add(Shl(x: S, C), y)): T
    where width(T) < width(S)
    check C >= width(T) and C < width(S)
    => ResizeU(y): T

resize_u_select: ResizeU(Select(c, C1: S, C2)): T
    Ctrue = bits(C1, T)
    Cfalse = bits(C2, T)
    => Select(c, Ctrue, Cfalse)

resize_u_constant: ResizeU(C: S): T
    Cresult = bits(C, T)
    => Cresult

resize_u_resize_x_roundtrip: ResizeU(ResizeX(x: T): U): T
    Cmask = bits(bits(-1, U), T)
    => And(x, Cmask)

resize_u_resize_u_roundtrip: ResizeU(ResizeU(x: T): U): T
    where width(U) < width(T)
    Cmask = bits(bits(-1, U), T)
    => And(x, Cmask)

resize_u_resize_u_widen: ResizeU(ResizeU(x: S): U): T
    where width(S) < width(U) < width(T)
    => ResizeU(x): T

resize_u_resize_u_truncate: ResizeU(ResizeU(x: S): U): T
    where width(T) < width(U) < width(S)
    => ResizeU(x): T

resize_u_resize_x_truncate: ResizeU(ResizeX(x: S): U): T
    where width(T) < width(U) < width(S)
    => ResizeU(x): T

resize_u_masked_resize_x_roundtrip: ResizeU(And(ResizeX(x: T): U, C)): T
    Cmask = bits(C, T)
    => And(x, Cmask)

resize_u_masked_resize_u_roundtrip: ResizeU(And(ResizeU(x: T): U, C)): T
    Cmask = bits(C, T)
    => And(x, Cmask)

resize_u_or_shl_bool: ResizeU(Or(x, Shl(x, y))): Bool
    => ResizeU(x): Bool

resize_u_or_shl_above_width: ResizeU(Or(x: S, Shl(y, C))): T
    where width(T) < width(S)
    check C >= width(T)
    => ResizeU(x): T

resize_u_sign_bit: ResizeU(ShrU(x: T, C)): Bool
    check C == width(T) - 1
    => LtS(x, 0)

resize_u_select_packed_constants: ResizeU(Select(c, Select(d, C1: S, C2), Or(Select(d, C3, C4), Shl(x, Cshift)))): T
    where width(T) < width(S)
    check Cshift >= width(T) and Cshift < width(S)
    Ctrue = bits(C1, T)
    Cfalse = bits(C2, T)
    check Ctrue == bits(C3, T) and Cfalse == bits(C4, T)
    => Select(d, Ctrue, Cfalse)

borrow_bit_extended_complement_resizex: ResizeU(ShrU(Add(Add(Or(ResizeX(Xor(y: S, -1)): T, Ctag), ResizeU(x: S): T), 1), Cshift)): Bool
    where width(S) < width(T)
    check Cshift == width(S)
    check Ctag == 1 << Cshift
    => LtU(x, y)

borrow_bit_extended_complement_resizeu: ResizeU(ShrU(Add(Add(Or(ResizeU(Xor(y: S, -1)): T, Ctag), ResizeU(x: S): T), 1), Cshift)): Bool
    where width(S) < width(T)
    check Cshift == width(S)
    check Ctag == 1 << Cshift
    => LtU(x, y)

resize_s_identity: ResizeS(x: T): T
    => x

resize_s_narrow: ResizeS(x: S): T
    where width(T) < width(S)
    => ResizeU(x): T

resize_x_identity: ResizeX(x: T): T
    => x

resize_x_narrow: ResizeX(x: S): T
    where width(T) < width(S)
    => ResizeU(x): T

resize_x_select: ResizeX(Select(c, C1: S, C2)): T
    where width(T) <= width(S)
    Ctrue = bits(C1, T)
    Cfalse = bits(C2, T)
    => Select(c, Ctrue, Cfalse)

resize_x_sign_bit: ResizeX(ShrU(x: T, C)): Bool
    check C == width(T) - 1
    => LtS(x, 0)

resize_x_resize_x_roundtrip: ResizeX(ResizeX(x: T): U): T
    where width(T) < width(U)
    => x

resize_x_resize_x_truncate: ResizeX(ResizeX(x: S): U): T
    where width(T) < width(U) < width(S)
    => ResizeX(x): T

resize_x_resize_u_roundtrip: ResizeX(ResizeU(x: T): U): T
    where width(T) < width(U)
    => x

resize_x_resize_u_truncate: ResizeX(ResizeU(x: S): U): T
    where width(T) < width(U) < width(S)
    => ResizeX(x): T

resize_x_constant_truncate: ResizeX(C: S): T
    where width(T) <= width(S)
    Cresult = bits(C, T)
    => Cresult

shl_zero: Shl(x, 0)
    => x

shl_zero_value: Shl(0, x)
    => 0

shl_constants: Shl(C1: T, C2)
    check C2 < width(T)
    C = C1 << C2
    => C

shl_select_constant: Shl(Select(c, C1, C2): T, C3)
    check C3 < width(T)
    Ctrue = C1 << C3
    Cfalse = C2 << C3
    => Select(c, Ctrue, Cfalse)

shl_selects: Shl(Select(c, C1, C2): T, Select(c, C3, C4))
    check C3 < width(T) and C4 < width(T)
    Ctrue = C1 << C3
    Cfalse = C2 << C4
    => Select(c, Ctrue, Cfalse)

shl_constant_select: Shl(C1: T, Select(c, C2, C3))
    check C2 < width(T) and C3 < width(T)
    Ctrue = C1 << C2
    Cfalse = C1 << C3
    => Select(c, Ctrue, Cfalse)

shl_shr_u_equal: Shl(ShrU(x: T, C1), C2)
    check C1 < width(T) and C2 < width(T) and C1 == C2
    Cmask = -1 << C2
    => And(x, Cmask)

shl_masked_shr_u_equal: Shl(And(ShrU(x: T, C1), Cmask), C2)
    check C1 < width(T) and C2 < width(T) and C1 == C2
    Cresult_mask = Cmask << C2
    => And(x, Cresult_mask)

shl_shl_in_range: Shl(Shl(x: T, C1), C2)
    check C1 < width(T) and C2 < width(T)
    Cshift = C1 + C2
    check Cshift < width(T)
    => Shl(x, Cshift)

shl_shl_out_of_range: Shl(Shl(x: T, C1), C2)
    check C1 < width(T) and C2 < width(T)
    Cshift = C1 + C2
    check Cshift >= width(T)
    => 0

shl_masked_shl_out_of_range: Shl(And(Shl(x: T, C1), Cmask), C2)
    check C1 < width(T) and C2 < width(T)
    Cshift = C1 + C2
    check Cshift >= width(T)
    => 0

shl_shr_u_right: Shl(ShrU(x: T, C1), C2)
    check C1 < width(T) and C2 < width(T) and C1 > C2
    Cshift = C1 - C2
    Cmask = -1 << C2
    => And(ShrU(x, Cshift), Cmask)

shl_shr_u_left: Shl(ShrU(x: T, C1), C2)
    check C1 < width(T) and C2 < width(T) and C1 < C2
    Cshift = C2 - C1
    Cmask = -1 << C2
    => And(Shl(x, Cshift), Cmask)

shl_masked_shr_u_right: Shl(And(ShrU(x: T, C1), Cmask), C2)
    check C1 < width(T) and C2 < width(T) and C1 > C2
    Cshift = C1 - C2
    Cresult_mask = Cmask << C2
    => And(ShrU(x, Cshift), Cresult_mask)

shl_masked_shr_u_left: Shl(And(ShrU(x: T, C1), Cmask), C2)
    check C1 < width(T) and C2 < width(T) and C1 < C2
    Cshift = C2 - C1
    Cresult_mask = Cmask << C2
    => And(Shl(x, Cshift), Cresult_mask)

shl_masked_shl_in_range: Shl(And(Shl(x: T, C1), Cmask), C2)
    check C1 < width(T) and C2 < width(T)
    Cshift = C1 + C2
    check Cshift < width(T)
    Cresult_mask = Cmask << C2
    => And(Shl(x, Cshift), Cresult_mask)

shr_u_zero: ShrU(x, 0)
    => x

shr_u_zero_value: ShrU(0, x)
    => 0

shr_u_shl_equal: ShrU(Shl(x: T, C), C)
    check C < width(T)
    Cmask = -1 >> C
    => And(x, Cmask)

shr_u_constants: ShrU(C1: T, C2)
    check C2 < width(T)
    C = C1 >> C2
    => C

shr_u_select_constant: ShrU(Select(c, C1, C2): T, C3)
    check C3 < width(T)
    Ctrue = C1 >> C3
    Cfalse = C2 >> C3
    => Select(c, Ctrue, Cfalse)

shr_u_selects: ShrU(Select(c, C1, C2): T, Select(c, C3, C4))
    check C3 < width(T) and C4 < width(T)
    Ctrue = C1 >> C3
    Cfalse = C2 >> C4
    => Select(c, Ctrue, Cfalse)

shr_u_constant_select: ShrU(C1: T, Select(c, C2, C3))
    check C2 < width(T) and C3 < width(T)
    Ctrue = C1 >> C2
    Cfalse = C1 >> C3
    => Select(c, Ctrue, Cfalse)

shr_s_zero: ShrS(x, 0)
    => x

shr_s_zero_value: ShrS(0, x)
    => 0
